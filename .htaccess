# Configuração para a Hostinger (Apache). O GitHub Pages ignora este arquivo.
# HTTPS: ligar "Forçar HTTPS" no painel da Hostinger depois que o certificado sair.

# Tipos certos para o app.
AddType application/manifest+json .webmanifest
AddType application/octet-stream .bin

# Página, app e versão sempre novos; imagens e apostilas podem ficar em cache.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|admin\.html|sw\.js|manifest\.webmanifest|version\.json|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
